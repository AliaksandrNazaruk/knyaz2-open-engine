# собранные файлы игры и копии оригиналов — не в репозиторий
build/
backup/
gfx/
maps_png/
content_build/

# промежуточные каталоги сборки content pack: сборка идёт в .stage-*, старая
# версия на время подмены уезжает в .previous-*. При обрыве сборки каталог
# остаётся на диске и весит столько же, сколько сам пак.
.content_build.stage-*/
.content_build.previous-*/

__pycache__/
*.pyc
*.egg-info/

catalog/tiles/
catalog/objects/
catalog/*_sheet*.png

# Опыты с ригом в Blender — лежат в корне, но к паку отношения не имеют
base_proportions_*
.codex_*
walk_preview_sequence/
walk_preview_frames/
mocap_sources/
mocap_preview_frames/
mocap_*

# Разбор оригинального движка: проект Ghidra и декомпилированный код — это
# производное от чужого бинарника, в репозиторий не кладём. Наша карта
# адресов (engine/names.json) остаётся.
engine/ghidra_project/
engine/decompiled/
# то же и для второй сборки: «Продолжение легенды» — такой же чужой бинарник,
# и его декомпилят (1056 файлов) воспроизводится
# `tools/ghidra_decompile.sh --game legend`
engine/decompiled_legend/

# Ретаргет женской походки — эксперименты в корне
female_walk_*

# ассеты стартового меню: картинки и пункты режутся из MENU.RES, ролик
# перекодируется из исходника. Всё воспроизводится tools/menu_extract.py
# и tools/menu_video.py, в репозиторий не идёт.
knyaz2/web/static/menu/

# трассы живых замеров оригинала (tools/livepeek.py): по мегабайту на прогон,
# смысл имеют только в тот день, когда сняты
trace-*.csv
trace-*.log
proba.csv
.publish-list

# пробные сборки пака под тесты и снятые с них слепки. Это ВЫХОД сборки, а
# не исходник: каждая весит сотни мегабайт (canon_20260813 — 405 МБ), и
# воспроизводится `python -m knyaz2.content.cli build`. Тесты, которым такой
# пак нужен, пропускаются, если его нет.
content_test_*/
content_build_*/

# настройки агента разработки
.claude/
engine/ghidra_import/

